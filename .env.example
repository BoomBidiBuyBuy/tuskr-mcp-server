# Tuskr tenant ID (UUID). Find it under Top Menu > Settings > API
# in the Tuskr web UI as "Tenant ID".
TUSKR_TENANT_ID=

# Legacy name — still accepted for backwards compatibility, but deprecated.
# New deployments should use TUSKR_TENANT_ID above.
# TUSKR_ACCOUNT_ID=

TUSKR_ACCESS_TOKEN=

# Directory the server may read result attachments from. Attachments are
# disabled while this is unset.
# TUSKR_ATTACHMENT_DIR=

# Server settings. The values shown are the defaults.
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# Tuskr API base URL. Only change it to point at a different host, such as a
# mock in tests. Keep the trailing slash.
# TUSKR_BASE_URL=https://api.tuskr.live/api/tenant/
